generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  SCHEDULED
  SENDING
  SENT
  FAILED
}

model User {
  id        String   @id @default(cuid())
  googleId  String?  @unique
  name      String
  email     String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders   Sender[]
  emails    Email[]
  slack     SlackConnection?
}

model Sender {
  id        String   @id @default(cuid())
  userId    String
  email     String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
}

model Email {
  id            String      @id @default(cuid())
  userId        String
  senderId      String
  recipient     String
  subject       String
  body          String

  scheduledAt   DateTime
  sentAt        DateTime?
  status        EmailStatus @default(SCHEDULED)
  bullJobId     String?     @unique
  idempotencyKey String      @unique
  minDelayMs    Int         @default(2000)
  hourlyLimit   Int         @default(200)
  error         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender        Sender      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([senderId, status])
  @@index([scheduledAt])
  @@index([recipient])
}

model SlackConnection {
  id          String   @id @default(cuid())
  userId      String   @unique
  accessToken String
  teamId      String?
  channelId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}